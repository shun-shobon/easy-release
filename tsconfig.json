{
  "extends": ["@tsconfig/node-lts/tsconfig.json", "@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src", "*.config.ts"]
}
